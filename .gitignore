# OS / editor cruft
.DS_Store
.Rhistory
.Rproj.user/
*.swp

# Large regenerable intermediates -- re-derivable from the pipeline, not
# source. Keep OUT of version control; re-run the relevant script instead
# of committing a fresh copy each time it changes.
*.RDS
*.rds

# Credentials / local machine config -- should never live in this repo
.Renviron
.env
*.pem

# August snapshot bundle of the simulation codebase. Deliberately excluded:
# it duplicates scripts that live tracked in the repo root, and is STALE for
# at least one of them (01i_camera_rn_sbatch.sh), so committing it would create
# exactly the two-parallel-forks problem this repo exists to avoid. The files
# that existed ONLY in the bundle have been recovered into the repo with
# provenance headers -- see PIPELINE.md section 4.
isdm_sim_codebase/
isdm_sim_codebase.tar.gz

# Service-account keys and credential files. This repo is public: never commit key
# material. Scripts read the path from GEE_SERVICE_ACCOUNT_KEY instead.
keys/
*-service-account*.json
*serviceaccount*.json
*.pem
*credentials*.json

# Python bytecode caches
__pycache__/
*.pyc
geo_cache/
